mgmw:PopMusic a skos:Concept ;
    skos:narrower mgmw:KPopMusic, mgmw:PPopMusic, mgmw:JPopMusic ;
    skos:inScheme <http://mgmw.org/musical-genres-works> ;
    skos:prefLabel "Pop music"@en ;
    skos:definition "popular music genre originating in the mid-1950s in the US and UK; initially overlapping with rock and roll, later becoming associated with more commercial, accessible, and ephemeral styles distinct from rock"@en ;
