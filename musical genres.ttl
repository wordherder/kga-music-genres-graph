# BRIDGE (ABox generation, not TBox) -- run against the SKOS file:
#
#   PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
#   PREFIX mgmw:  <http://mgmw.org/musical-genres-works#>
#   PREFIX mgmwo: <http://mgmw.org/ontology#>
#   CONSTRUCT { ?g a mgmwo:Genre }
#   WHERE {
#     ?g skos:broader+ mgmw:MusicalGenres .
#     FILTER (?g != mgmw:SymphonicPoem)   # route to mgmwo:MusicalForm instead
#   }
# ---------------------------------------------------------------------
